{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/exhaustive-deps": "warn",
    "react/rules-of-hooks": "error",
    "react/no-array-index-key": "off",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "build",
    "android",
    "ios",
    "coverage",
    "node_modules"
  ]
}
