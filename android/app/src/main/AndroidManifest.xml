<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Per-widget appearance. configuration_optional in the provider XML
          means Android 12+ places the widget with defaults and offers this
          later; older versions show it when the widget is added.
        -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/config_title"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.WidgetPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          Widget receivers. exported="false" as the platform documentation
          shows: the AppWidget framework delivers to these directly, and the
          alarm below is an explicit intent from this app to itself.
        -->
        <receiver
            android:name=".widget.NextPrayerTileProvider"
            android:exported="false"
            android:label="@string/widget_tile_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_prayer_tile_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesCompactWidgetProvider"
            android:exported="false"
            android:label="@string/widget_compact_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_compact_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesColumnWidgetProvider"
            android:exported="false"
            android:label="@string/widget_column_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_column_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesWidgetProvider"
            android:exported="false"
            android:label="@string/widget_times_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesVerticalWidgetProvider"
            android:exported="false"
            android:label="@string/widget_vertical_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_vertical_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetAlarmReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Prayer reminders have to fire at the exact minute to be useful, so exact
      alarms are central to what this app does. SCHEDULE_EXACT_ALARM is granted
      automatically up to API 32; from API 33 USE_EXACT_ALARM covers it without
      prompting. Without these, targetSdk 31+ silently downgrades every
      scheduled notification to an inexact alarm.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
</manifest>
