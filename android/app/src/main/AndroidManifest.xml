<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Per-widget appearance. configuration_optional in the provider XML
          means Android 12+ places the widget with defaults and offers this
          later; older versions show it when the widget is added.
        -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/config_title"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.WidgetPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          Widget receivers. exported="false" as the platform documentation
          shows: the AppWidget framework delivers to these directly, and the
          alarm below is an explicit intent from this app to itself.

          Every one is labelled with the app's own name. A receiver's label is
          a single string that Android shows in two places - beside the preview
          in the widget picker, and beneath the widget once it is on the home
          screen - with no way to distinguish the two. Names per widget read
          well in the picker and turn into a row of captions across the home
          screen, so the picker leans on its previews and descriptions instead.
          The per-widget names live on in strings.xml for the app's own
          "widget appearance" list, which is ours to lay out.
        -->
        <receiver
            android:name=".widget.NextPrayerTileProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_prayer_tile_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesCompactWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_compact_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesColumnWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_column_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesVerticalWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_vertical_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetAlarmReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Prayer reminders have to fire at the exact minute. From API 31 the user
      can turn that off under Alarms & reminders, and from Android 14 a new
      install starts with it off. The settings screen warns and opens that
      page. Without this permission every scheduled notification is inexact.
      USE_EXACT_ALARM would hide the switch; Play only allows it for alarm
      clock and calendar apps, so it is not declared.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
