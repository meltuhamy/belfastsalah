<?xml version="1.0" encoding="utf-8"?>
<!--
  The sample text below is what the widget picker shows: previewLayout renders
  this file as it stands, and every string is overwritten the moment the widget
  is actually drawn. Without it the picker offers five identical white boxes,
  which is how the one-column widget became impossible to find.
-->
<!--
  The FrameLayout only carries the Sky palette's picture, behind everything
  else: RemoteViews cannot give a view a gradient at runtime, so the sky is
  drawn as a bitmap (SkyPainter) into sky_background. Hidden in every other
  palette, where the content's own background colour is the widget's.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/sky_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tile_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tile_prayer"
            android:text="Duhr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp" />

        <Chronometer
            android:id="@+id/tile_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tile_location"
            android:text="London"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
