        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/prayer_name_5"
            android:text="Isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
