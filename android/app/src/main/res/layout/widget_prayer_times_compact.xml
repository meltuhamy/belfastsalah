<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole timetable on one row. The countdown has no line of its own: it goes
  inside the next prayer's box, small, under its time.

  The sample text is what the widget picker shows: previewLayout renders this
  file as it stands, and every string is overwritten the moment the widget is
  actually drawn. Without it the picker offers five identical white boxes,
  which is how the one-column widget became impossible to find.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/compact_col_0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/compact_name_0"
            android:text="Fajr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/compact_time_0"
            android:text="05:36"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!--
          Only ever visible in the next prayer's column, which is what keeps
          the countdown inside the highlight rather than costing the row a
          second line of its own.
        -->
        <Chronometer
            android:id="@+id/compact_countdown_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/compact_col_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="3dp"
