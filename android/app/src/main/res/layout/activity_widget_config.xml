<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/config_background"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/config_palette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RadioButton
            android:id="@+id/palette_system"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_bg_system" />
        <RadioButton
            android:id="@+id/palette_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_bg_light" />
        <RadioButton
            android:id="@+id/palette_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_bg_dark" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/config_opacity"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/config_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/config_text_colour"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/config_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RadioButton
            android:id="@+id/text_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_text_auto" />
        <RadioButton
            android:id="@+id/text_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_text_light" />
        <RadioButton
            android:id="@+id/text_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_text_dark" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/config_highlight"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/config_accent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RadioButton
            android:id="@+id/accent_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_accent_blue" />
        <RadioButton
            android:id="@+id/accent_green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_accent_green" />
        <RadioButton
            android:id="@+id/accent_amber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_accent_amber" />
        <RadioButton
            android:id="@+id/accent_violet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_accent_violet" />
        <RadioButton
            android:id="@+id/accent_none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_accent_none" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/config_countdown"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/config_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RadioButton
            android:id="@+id/countdown_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_countdown_seconds" />
        <RadioButton
            android:id="@+id/countdown_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_countdown_time" />
        <RadioButton
            android:id="@+id/countdown_none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_countdown_none" />
    </RadioGroup>

        <Button
            android:id="@+id/config_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/config_save" />
    </LinearLayout>
</ScrollView>
